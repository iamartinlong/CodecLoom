<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SimdCodecs.Tests</RootNamespace>
    <AssemblyName>SimdCodecs.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- 集成测试直接启动真实 Kestrel，需要 ASP.NET Core 共享框架类型 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimdCodecs.Core\SimdCodecs.Core.csproj" />
    <ProjectReference Include="..\SimdCodecs.Processing\SimdCodecs.Processing.csproj" />
    <ProjectReference Include="..\SimdCodecs.Document\SimdCodecs.Document.csproj" />
    <ProjectReference Include="..\SimdCodecs.Api\SimdCodecs.Api.csproj" />
  </ItemGroup>

  <!-- Web 测试台随测试输出目录走，集成测试才能验证 GET / 不是 404 -->
  <ItemGroup>
    <Content Include="..\SimdCodecs.Api\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\SimdCodecs.Api\appsettings.json" Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
