{
  "ApiRuntime": {
    "StructuredLog": true,
    "Auth": {
      "Enabled": false,
      "Key": "",
      "HeaderName": "X-Api-Key"
    },
    "RateLimit": {
      "Enabled": false,
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Document": {
    "Enabled": false,
    "Backend": "cpu",
    "Model": "tiny",
    "MaxPixels": 4000000,
    "MaxEdge": 2400,
    "TimeoutSeconds": 60,
    "MaxConcurrency": 1,
    "MaxTextChars": 200000,
    "WarnWhenUnauthenticated": true
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 67108864
    }
  }
}
